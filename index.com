          <a href="mailto:expedition1.618@gmail.com" class="contact-link" data-track="contact_email">
            <div class="contact-icon icon-pop">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v16H4z" fill="none" stroke="none"/><path d="M22 6l-10 7L2 6"/><rect x="2" y="4" width="20" height="16" rx="2"/></svg>
            </div>
            <div>
              <div class="contact-label">Email</div>
