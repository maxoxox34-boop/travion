  <!-- Footer -->
  <footer>
    <div class="container footer-inner">
      <img src="data:image/png;base64," alt="Travion Travels" class="footer-logo-img" />
      <p class="footer-note">© 2026 Travion Travels. Book and safe traveling and enjoy. · expedition1.618@gmail.com · +91 9947998531</p>
    </div>
  </footer>

<script>
  const EMAIL = "expedition1.618@gmail.com";

  // ---------------------------------------------------------------------
  // Tracking helper — safe no-op if Google Analytics isn't set up yet or
  // is blocked (ad blockers, etc.), so it never breaks the site.
  // ---------------------------------------------------------------------
  function trackEvent(action, params) {
    if (typeof gtag === 'function') {
      gtag('event', action, params || {});
    }
  }

  // Fires a WhatsApp/email click event with which button it was, so you
  // can see in Google Analytics which buttons people actually use.
  document.addEventListener('click', (e) => {
    const el = e.target.closest('[data-track]');
    if (!el) return;
    trackEvent('contact_click', {
      button: el.dataset.track,
      package_name: el.dataset.package || undefined,
    });
  });

  // ---------------------------------------------------------------------
  // Tracking Location — no external Google Maps webpage link. Clicking
  // any button with class "tracking-btn" opens an in-page panel that
  // gets the visitor's location, then shows a small map plus options to
  // view the coordinates, copy them, or share them on WhatsApp — no
  // Google Maps involved.
  // ---------------------------------------------------------------------
  const locationMapWrap = document.getElementById('location-map-wrap');
  const trackingCoords = document.getElementById('tracking-coords');
  const trackingPanelStatus = document.getElementById('tracking-panel-status');
  const trackingOptions = document.getElementById('tracking-options');
  const trackingOptCopy = document.getElementById('tracking-opt-copy');
  const trackingOptWhatsapp = document.getElementById('tracking-opt-whatsapp');

  function setLabel(btn, text) {
    const label = btn.querySelector('.tracking-btn-label');
    if (label) label.textContent = text;
  }

  document.querySelectorAll('.tracking-btn').forEach((btn) => {
    const defaultText = btn.querySelector('.tracking-btn-label')?.textContent || 'Tracking Location';

    btn.addEventListener('click', (e) => {
      e.preventDefault();

      if (!('geolocation' in navigator) || !locationMapWrap) {
        trackingPanelStatus.textContent = "Location isn't supported on this device.";
        trackingPanelStatus.style.display = 'block';
        trackingCoords.style.display = 'none';
        trackingOptions.style.display = 'none';
        locationMapWrap?.classList.add('show');
        locationMapWrap?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        return;
      }

      setLabel(btn, 'Getting your location…');
      trackingPanelStatus.textContent = 'Getting your location…';
      trackingPanelStatus.style.display = 'block';
      trackingCoords.style.display = 'none';
      trackingOptions.style.display = 'none';
      locationMapWrap.classList.add('show');
      locationMapWrap.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

      navigator.geolocation.getCurrentPosition(
        (position) => {
          const latitude = position.coords.latitude.toFixed(6);
          const longitude = position.coords.longitude.toFixed(6);
          const coordsText = `${latitude}, ${longitude}`;
          const waText = encodeURIComponent(`Hi Travion, here's my live location: ${coordsText}`);

          setLabel(btn, defaultText);
          trackingPanelStatus.style.display = 'none';
          trackingCoords.textContent = coordsText;
          trackingCoords.style.display = 'block';
          trackingOptions.style.display = 'flex';

          trackingOptWhatsapp.href = `https://wa.me/918921920781?text=${waText}`;
          trackingOptCopy.onclick = async () => {
            const originalHTML = trackingOptCopy.innerHTML;
            try {
              await navigator.clipboard.writeText(coordsText);
              trackingOptCopy.textContent = 'Copied!';
            } catch (err) {
              prompt('Copy your location:', coordsText);
            }
            setTimeout(() => { trackingOptCopy.innerHTML = originalHTML; }, 1800);
          };
        },
        (error) => {
          console.warn('Geolocation error:', error);
          setLabel(btn, defaultText);
          trackingPanelStatus.textContent = "Couldn't get your location — please allow location access and try again.";
          trackingCoords.style.display = 'none';
          trackingOptions.style.display = 'none';
        },
        { enableHighAccuracy: true, timeout: 10000 }
      );
    });
  });

  // ---------------------------------------------------------------------
  // Scroll reveal observer (defined early so render functions can use it
  // to observe elements as soon as they're created)
  // ---------------------------------------------------------------------
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('in');
        revealObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15 });

  // ---------------------------------------------------------------------
  // Data
  // ---------------------------------------------------------------------
  const packages = [
    { name: "Industry Visit Package", tag: "Corporate", desc: "Curated visits to leading industries, campuses, and landmarks — built for student and professional groups.", img: "data:image/jpeg;base64," },
    { name: "Honeymoon Package", tag: "Romantic", desc: "Private, unhurried getaways for newlyweds — quiet stays, sunset views, and time that's just yours.", img: "data:image/webp;base64," },
    { name: "Family Package", tag: "Family", desc: "Easy, fun-filled trips planned around everyone's pace — kids included, stress left behind.", img: "data:image/jpeg;base64," },
  ];

  const policyPoints = [
    "Advance payment must be made at the time of booking the vehicle.",
    "The booked trip cannot be cancelled by phone.",
    "No changes can be made to the agreed travel schedule.",
    "If the vehicle is delayed due to strikes, natural calamities, road blocks, accidents, or other unavoidable reasons, the company will not be responsible for any loss or inconvenience.",
    "If the customer cancels the booking, 45% of the advance amount will be deducted as cancellation charges.",
    "If the customer wishes to extend the trip, it is subject to the availability of the vehicle, and all additional charges must be paid.",
    "The company is not responsible for delays caused by traffic blocks, road conditions, weather, or similar circumstances.",
    "The customer is responsible for any damage caused to the vehicle by passengers, including damage to seats, interiors, or other parts, and must bear the repair costs.",
    "Passengers must not carry illegal goods, prohibited items, or dangerous materials in the vehicle.",
    "Smoking, alcohol consumption, and drug use are strictly prohibited inside the vehicle.",
    "Passengers must follow the driver's instructions during the journey. Any loss caused by failure to do so will be the passenger's responsibility.",
    "Before starting the journey, the customer must verify all details in the booking. By signing this agreement, the customer confirms that they have read, understood, and accepted all the above terms and conditions.",
  ];

  // ---------------------------------------------------------------------
  // Render dynamic sections
  // ---------------------------------------------------------------------
  const packagesGrid = document.getElementById('packages-grid');
  packages.forEach((p, i) => {
    const card = document.createElement('div');
    card.className = 'reveal';
    card.style.transitionDelay = (i * 90) + 'ms';
    const waText = encodeURIComponent(`Hi Travion, I'd like to know more about the ${p.name}.`);
    card.innerHTML = `
      <div class="package-card card-hover">
        <div class="package-img-wrap">
          <img src="${p.img}" alt="${p.name}" />
          <span class="package-tag">${p.tag}</span>
        </div>
        <div class="package-body">
          <h3 class="package-name display">${p.name}</h3>
          <p class="package-desc">${p.desc}</p>
          <div class="package-footer">
            <a href="https://wa.me/918921920781?text=${waText}" target="_blank" rel="noopener noreferrer" class="book-link link-underline" data-track="package_book" data-package="${p.name}">
              Book
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
            </a>
          </div>
        </div>
      </div>`;
    packagesGrid.appendChild(card);
  });

  // ---------------------------------------------------------------------
  // Customer reviews — customers can post anything, and it shows on the
  // site right away. Kept in memory (always works) and best-effort saved
  // to localStorage so it's still there next time this visitor returns.
  //
  // Optional: if you want every visitor to see everyone else's reviews
  // (not just their own device), wire this up to a free shared backend —
  // see REVIEWS-BACKEND-SETUP.gs for step-by-step instructions. Paste
  // that Web App URL below. Leave it blank to skip that and keep things
  // simple (each visitor just sees reviews added on their own device).
  // ---------------------------------------------------------------------
  const REVIEWS_API_URL = ""; // optional — paste a Google Apps Script Web App URL here
  const backendConfigured = REVIEWS_API_URL.trim().length > 0;

  let reviewsCache = [];

  function loadLocalReviews() {
    try {
      return JSON.parse(localStorage.getItem('drona_reviews') || '[]');
    } catch (e) {
      return [];
    }
  }

  function saveLocalReviews(list) {
    try {
      localStorage.setItem('drona_reviews', JSON.stringify(list));
    } catch (e) { /* storage unavailable — review still shows for this session */ }
  }

  const reviewsGrid = document.getElementById('reviews-grid');
  const reviewsEmpty = document.getElementById('reviews-empty');

  function paintReviews() {
    reviewsGrid.innerHTML = '';
    if (!reviewsCache.length) {
      reviewsEmpty.style.display = 'block';
      return;
    }
    reviewsEmpty.style.display = 'none';
    reviewsCache.slice().reverse().forEach((r, i) => {
      const card = document.createElement('div');
      card.className = 'reveal';
      card.style.transitionDelay = (Math.min(i, 5) * 90) + 'ms';
      const rating = parseInt(r.rating, 10) || 0;
      const stars = '★'.repeat(rating) + '☆'.repeat(5 - rating);
      const safeName = (r.name || 'Traveller').toString();
      const safeQuote = (r.quote || '').toString();
      const safeDate = (r.date || '').toString();
      card.innerHTML = `
        <div class="review-card card-hover">
          <button type="button" class="review-delete" data-review-id="${r.id}" aria-label="Delete review" title="Delete this review">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
          <div class="review-stars-display">${stars}</div>
          <p class="review-quote">"${safeQuote}"</p>
          <div class="review-meta">
            <div class="review-name">${safeName}</div>
            <div class="review-date">${safeDate}</div>
          </div>
        </div>`;
      reviewsGrid.appendChild(card);
      revealObserver.observe(card);
    });
  }

  async function initReviews() {
    if (backendConfigured) {
      try {
        const res = await fetch(REVIEWS_API_URL);
        if (!res.ok) throw new Error('Request failed');
        reviewsCache = await res.json();
        paintReviews();
        return;
      } catch (e) {
        console.warn('Could not load shared reviews, showing local ones only.', e);
      }
    }
    reviewsCache = loadLocalReviews();
    paintReviews();
  }

  initReviews();

  // ---------------------------------------------------------------------
  // Delete a review — removes it from the grid, local storage, and (if
  // configured) the shared backend. Anyone viewing the site can delete
  // any review shown to them, since there's no login system here — for
  // full moderation control, you can also delete rows directly in the
  // Google Sheet if you've set up the shared backend.
  // ---------------------------------------------------------------------
  reviewsGrid.addEventListener('click', async (e) => {
    const btn = e.target.closest('.review-delete');
    if (!btn) return;
    const id = btn.dataset.reviewId;
    if (!confirm('Delete this review?')) return;

    reviewsCache = reviewsCache.filter((r) => String(r.id) !== String(id));
    paintReviews();
    saveLocalReviews(reviewsCache);
    trackEvent('review_delete', {});

    if (backendConfigured) {
      try {
        await fetch(REVIEWS_API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify({ action: 'delete', id }),
        });
      } catch (e) {
        console.warn('Could not remove review from shared backend.', e);
      }
    }
  });

  // ---------------------------------------------------------------------
  // Star picker
  // ---------------------------------------------------------------------
  let selectedRating = 0;
  const starButtons = document.querySelectorAll('.star-btn');
  starButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      selectedRating = parseInt(btn.dataset.value, 10);
      starButtons.forEach((b) => {
        b.classList.toggle('filled', parseInt(b.dataset.value, 10) <= selectedRating);
      });
    });
  });

  // ---------------------------------------------------------------------
  // Submit a new review — always shows immediately, regardless of
  // whether local storage or a shared backend is available.
  // ---------------------------------------------------------------------
  const reviewForm = document.getElementById('review-form');
  const reviewSuccess = document.getElementById('review-success');
  const reviewSubmitBtn = document.getElementById('review-submit-btn');

  reviewForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = document.getElementById('review-name').value.trim();
    const message = document.getElementById('review-message').value.trim();
    if (!name || !message || selectedRating === 0) {
      if (selectedRating === 0) alert('Please select a star rating.');
      return;
    }

    const review = {
      id: Date.now().toString(36) + Math.random().toString(36).slice(2, 8),
      name,
      rating: selectedRating,
      quote: message,
      date: new Date().toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }),
    };

    reviewSubmitBtn.disabled = true;
    reviewSubmitBtn.textContent = 'Posting…';

    trackEvent('review_submit', { rating: selectedRating });

    // Show it immediately, no matter what.
    reviewsCache.push(review);
    paintReviews();
    saveLocalReviews(reviewsCache);

    if (backendConfigured) {
      try {
        await fetch(REVIEWS_API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify(review),
        });
      } catch (e) {
        console.warn('Could not reach shared review backend, review is saved on this device only.', e);
      }
    }

    reviewForm.reset();
    starButtons.forEach((b) => b.classList.remove('filled'));
    selectedRating = 0;
    reviewSubmitBtn.disabled = false;
    reviewSubmitBtn.innerHTML = 'Post Review <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>';
    reviewForm.style.display = 'none';
    reviewSuccess.classList.add('show');
    setTimeout(() => {
      reviewForm.style.display = 'flex';
      reviewSuccess.classList.remove('show');
    }, 3000);
  });

  const policyList = document.getElementById('policy-list');
  const policyItems = document.createElement('ol');
  policyItems.className = 'policy-items';
  policyPoints.forEach((point) => {
    const li = document.createElement('li');
    li.className = 'policy-item';
    li.textContent = point;
    policyItems.appendChild(li);
  });
  policyList.appendChild(policyItems);

  // ---------------------------------------------------------------------
  // Magic: generate twinkling sparkles in the hero
  // ---------------------------------------------------------------------
  (function initSparkleField() {
    const field = document.getElementById('sparkle-field');
    if (!field) return;
    const COUNT = 26;
    for (let i = 0; i < COUNT; i++) {
      const s = document.createElement('span');
      s.className = 'sparkle' + (Math.random() < 0.4 ? ' blue' : '');
      s.style.left = Math.random() * 100 + '%';
      s.style.top = Math.random() * 100 + '%';
      s.style.animationDelay = (Math.random() * 3.2).toFixed(2) + 's';
      s.style.animationDuration = (2.4 + Math.random() * 2.2).toFixed(2) + 's';
      field.appendChild(s);
    }
  })();

  // ---------------------------------------------------------------------
  // Magic: subtle cursor sparkle trail (desktop only, throttled)
  // ---------------------------------------------------------------------
  (function initCursorSparkle() {
    if (window.matchMedia('(pointer: coarse)').matches) return; // skip on touch devices
    let last = 0;
    document.addEventListener('mousemove', (e) => {
      const now = Date.now();
      if (now - last < 60) return;
      last = now;
      const dot = document.createElement('div');
      dot.className = 'cursor-sparkle';
      dot.style.left = e.clientX + 'px';
      dot.style.top = e.clientY + 'px';
      document.body.appendChild(dot);
      setTimeout(() => dot.remove(), 700);
    });
  })();

  // ---------------------------------------------------------------------
  // Page loader
  // ---------------------------------------------------------------------
  window.addEventListener('load', () => {
    setTimeout(() => {
      document.getElementById('page-loader').classList.add('hide');
    }, 1100);
  });

  // ---------------------------------------------------------------------
  // Scroll progress + nav shadow + parallax
  // ---------------------------------------------------------------------
  const progressBar = document.getElementById('scroll-progress');
  const header = document.getElementById('site-header');
  const heroBg = document.getElementById('hero-bg');
  let ticking = false;

  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      const doc = document.documentElement;
      const max = doc.scrollHeight - doc.clientHeight;
      progressBar.style.width = (max > 0 ? (window.scrollY / max) * 100 : 0) + '%';
      header.classList.toggle('scrolled', window.scrollY > 12);
      heroBg.style.transform = `translateY(${window.scrollY * 0.3}px) scale(1.15)`;
      ticking = false;
    });
  }
  window.addEventListener('scroll', onScroll, { passive: true });

  // ---------------------------------------------------------------------
  // Kinetic: wrap section titles into per-word spans for the reveal effect
  // ---------------------------------------------------------------------
  document.querySelectorAll('.kinetic-title').forEach((el) => {
    const words = el.textContent.trim().split(/\s+/);
    el.innerHTML = words.map((w) => `<span class="kinetic-word"><span>${w}</span></span>`).join(' ');
  });

  // ---------------------------------------------------------------------
  // Observe any remaining static .reveal / .kinetic-title elements
  // ---------------------------------------------------------------------
  document.querySelectorAll('.reveal, .kinetic-title, .scale-in-img').forEach((el) => revealObserver.observe(el));

  // ---------------------------------------------------------------------
  // Magic: magnetic pull on primary buttons (Nike-style hover)
  // ---------------------------------------------------------------------
  (function initMagneticButtons() {
    if (window.matchMedia('(pointer: coarse)').matches) return;
    document.querySelectorAll('.btn-solid, .btn-outline, .nav-cta').forEach((btn) => {
      btn.classList.add('magnetic');
      btn.addEventListener('mousemove', (e) => {
        const r = btn.getBoundingClientRect();
        const x = e.clientX - r.left - r.width / 2;
        const y = e.clientY - r.top - r.height / 2;
        btn.style.transform = `translate(${x * 0.25}px, ${y * 0.35}px)`;
      });
      btn.addEventListener('mouseleave', () => { btn.style.transform = 'translate(0, 0)'; });
    });
  })();

  // ---------------------------------------------------------------------
  // Mobile menu
  // ---------------------------------------------------------------------
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');
  menuToggle.addEventListener('click', () => {
    const open = mobileMenu.classList.toggle('open');
    iconMenu.style.display = open ? 'none' : 'block';
    iconClose.style.display = open ? 'block' : 'none';
  });

  // ---------------------------------------------------------------------
  // Nav link transition wipe + smooth scroll
  // ---------------------------------------------------------------------
  const wipe = document.getElementById('transition-wipe');
  document.querySelectorAll('.nav-link').forEach((link) => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      mobileMenu.classList.remove('open');
      iconMenu.style.display = 'block';
      iconClose.style.display = 'none';
      const targetId = link.getAttribute('href').slice(1);
      wipe.classList.add('show');
      setTimeout(() => {
        const el = document.getElementById(targetId);
        if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        setTimeout(() => wipe.classList.remove('show'), 350);
      }, 320);
    });
  });

  // ---------------------------------------------------------------------
  // Feedback form -> opens mail client
  // ---------------------------------------------------------------------
  const feedbackForm = document.getElementById('feedback-form');
  const feedbackSuccess = document.getElementById('feedback-success');
  feedbackForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = document.getElementById('fb-name').value || 'a traveller';
    const message = document.getElementById('fb-message').value;
    const subject = encodeURIComponent(`Feedback from ${name}`);
    const body = encodeURIComponent(message);
    trackEvent('feedback_submit', {});
    window.location.href = `mailto:${EMAIL}?subject=${subject}&body=${body}`;
    feedbackForm.style.display = 'none';
    feedbackSuccess.classList.add('show');
  });
</script>
</body>
</html>
