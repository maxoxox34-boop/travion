       1. Go to https://analytics.google.com and create a free account
          + property for your website (Admin > Create Property).
       2. It gives you a Measurement ID that looks like: G-XXXXXXXXXX
       3. Replace BOTH occurrences of G-XXXXXXXXXX below with your ID.
     Until you do that, this snippet is inactive and sends no data.
     =================================================================== -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-XXXXXXXXXX');
</script>

<style>
  :root {
    --ink: #101314;
    --white: #ffffff;
    --signal: #0b5fff;
    --steel: #6b7280;
    --fog: #e9ecef;
    --whatsapp: #25d366;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'Inter', sans-serif;
    color: var(--ink);
    background: var(--white);
    overflow-x: hidden;
  }

  img { max-width: 100%; display: block; }
  a { text-decoration: none; color: inherit; }
  button { font-family: inherit; cursor: pointer; border: none; }

  .container { max-width: 1280px; margin: 0 auto; padding: 0 24px; }
  @media (min-width: 768px) { .container { padding: 0 40px; } }

  .display { font-family: 'Archivo Black', sans-serif; }

  /* ---- Loader ---- */
  #page-loader {
    position: fixed; inset: 0; z-index: 100;
    background: var(--ink);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    transition: opacity 0.5s ease, visibility 0.5s ease, transform 0.6s cubic-bezier(0.76,0,0.24,1);
  }
  #page-loader.hide { opacity: 0; visibility: hidden; transform: translateY(-100%); }
  .loader-logo-img {
    width: clamp(110px, 20vw, 180px);
    height: auto;
    animation: loaderLogoIn 0.6s cubic-bezier(0.16,1,0.3,1) both;
  }
  .loader-track {
    margin-top: 24px; width: 160px; height: 3px; overflow: hidden;
    background: rgba(255,255,255,0.15);
  }
  .loader-bar {
    height: 100%; width: 0%; background: var(--signal);
    animation: loaderBarFill 0.9s cubic-bezier(0.4,0,0.2,1) 0.2s forwards;
  }
  @keyframes loaderLogoIn { from { opacity: 0; transform: scale(0.85); } to { opacity: 1; transform: scale(1); } }
  @keyframes loaderBarFill { from { width: 0%; } to { width: 100%; } }

  /* ---- Transition wipe ---- */
  #transition-wipe {
    position: fixed; inset: 0; z-index: 90; pointer-events: none;
    background: var(--ink);
    transform-origin: top; transform: scaleY(0);
    transition: transform 0.45s cubic-bezier(0.76,0,0.24,1);
  }
  #transition-wipe.show { transform: scaleY(1); }

  /* ---- Scroll progress ---- */
  #scroll-progress {
    position: fixed; top: 0; left: 0; height: 3px; width: 0%;
    background: var(--signal); z-index: 60; transition: width 0.1s linear;
  }

  /* ---- Nav ---- */
  header {
    position: sticky; top: 0; z-index: 50; width: 100%;
    background: var(--ink);
    transition: box-shadow 0.3s ease;
  }
  header.scrolled { box-shadow: 0 8px 24px rgba(0,0,0,0.25); }
  .nav-inner {
    height: 80px; display: flex; align-items: center; justify-content: space-between;
  }
  .nav-logo-img {
    height: 52px; width: auto;
    animation: floatSlow 4s ease-in-out infinite;
  }
  .nav-links { display: none; align-items: center; gap: 40px; }
  .nav-links a {
    color: var(--white); font-size: 14px; text-transform: uppercase; letter-spacing: 0.12em;
    transition: opacity 0.2s ease;
  }
  .nav-links a:hover { opacity: 0.7; }
  .nav-cta {
    display: none; align-items: center; gap: 8px;
    background: var(--signal); color: var(--white);
    padding: 12px 24px; font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
  }
  .menu-btn { background: none; color: var(--white); }
  @media (min-width: 768px) {
    .nav-links, .nav-cta { display: inline-flex; }
    .menu-btn { display: none; }
  }
  .mobile-menu {
    display: none; flex-direction: column; gap: 16px;
    background: var(--ink); padding: 0 24px 24px;
  }
  .mobile-menu.open { display: flex; }
  .mobile-menu a { color: var(--white); font-size: 14px; text-transform: uppercase; letter-spacing: 0.12em; }
  .mobile-menu .nav-cta { display: inline-flex; width: fit-content; margin-top: 8px; }

  /* ---- Buttons / interactions ---- */
  .btn-anim { position: relative; overflow: hidden; transition: transform 0.25s ease, box-shadow 0.25s ease; }
  .btn-anim:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(11,95,255,0.35); }
  .btn-anim:active { transform: translateY(0); }

  /* ---- Magic: button shimmer sweep ---- */
  .btn-anim::before {
    content: ""; position: absolute; top: 0; left: -60%; width: 40%; height: 100%;
    background: linear-gradient(120deg, transparent, rgba(255,255,255,0.55), transparent);
    transform: skewX(-20deg); pointer-events: none;
  }
  .btn-anim:hover::before { animation: btnShimmer 0.9s ease forwards; }
  @keyframes btnShimmer { from { left: -60%; } to { left: 130%; } }

  /* ---- Magic: sparkle particles ---- */
  .sparkle-field { position: absolute; inset: 0; pointer-events: none; overflow: hidden; z-index: 1; }
  .sparkle {
    position: absolute; width: 3px; height: 3px; border-radius: 50%;
    background: #fff; box-shadow: 0 0 6px 1px rgba(255,255,255,0.9);
    opacity: 0; animation: sparkleTwinkle 3.2s ease-in-out infinite;
  }
  .sparkle.blue { background: var(--signal); box-shadow: 0 0 8px 2px rgba(11,95,255,0.8); }
  @keyframes sparkleTwinkle {
    0%, 100% { opacity: 0; transform: scale(0.4) rotate(0deg); }
    50% { opacity: 1; transform: scale(1.4) rotate(180deg); }
  }

  /* ---- Magic: glowing hero title accent ---- */
  .hero-title span {
    position: relative;
    animation: glowPulse 2.6s ease-in-out infinite;
  }
  @keyframes glowPulse {
    0%, 100% { text-shadow: 0 0 18px rgba(11,95,255,0.35); }
    50% { text-shadow: 0 0 34px rgba(11,95,255,0.85), 0 0 60px rgba(11,95,255,0.35); }
  }

  /* ---- Magic: cursor sparkle trail ---- */
  .cursor-sparkle {
    position: fixed; top: 0; left: 0; z-index: 200; pointer-events: none;
    width: 6px; height: 6px; border-radius: 50%;
    background: radial-gradient(circle, #fff 0%, var(--signal) 70%, transparent 100%);
    animation: cursorSparkleFade 0.7s ease-out forwards;
  }
  @keyframes cursorSparkleFade {
    from { opacity: 1; transform: scale(1) translate(-50%, -50%); }
    to { opacity: 0; transform: scale(0.2) translate(-50%, -50%) translateY(18px); }
  }

  /* ---- Kinetic: scrolling marquee banner ---- */
  .marquee-strip {
    background: var(--ink); overflow: hidden; padding: 18px 0;
    border-top: 1px solid rgba(255,255,255,0.08); border-bottom: 1px solid rgba(255,255,255,0.08);
  }
  .marquee-track {
    display: flex; width: max-content;
    animation: marqueeScroll 22s linear infinite;
  }
  .marquee-track span {
    display: inline-flex; align-items: center;
    font-family: 'Archivo Black', sans-serif; font-size: clamp(1.1rem, 3vw, 1.8rem);
    color: var(--white); text-transform: uppercase; letter-spacing: 0.04em;
    padding: 0 28px; white-space: nowrap;
  }
  .marquee-track span::after {
    content: "✦"; margin-left: 28px; color: var(--signal); font-size: 0.7em;
  }
  @keyframes marqueeScroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  /* ---- Kinetic: word-by-word title reveal (Nike-style) ---- */
  .kinetic-title { overflow: hidden; }
  .kinetic-word {
    display: inline-block; overflow: hidden; vertical-align: top;
  }
  .kinetic-word span {
    display: inline-block;
    transform: translateY(115%);
    transition: transform 0.8s cubic-bezier(0.16,1,0.3,1);
  }
  .kinetic-title.in .kinetic-word span { transform: translateY(0); }

  /* ---- Kinetic: image scale-in on scroll (Nike product zoom) ---- */
  .scale-in-img { overflow: hidden; }
  .scale-in-img img { transform: scale(1.25); transition: transform 1.1s cubic-bezier(0.16,1,0.3,1); }
  .scale-in-img.in img { transform: scale(1); }

  /* ---- Magic: magnetic buttons ---- */
  .magnetic { will-change: transform; transition: transform 0.25s cubic-bezier(0.16,1,0.3,1); }

  .icon-pop { transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1); }
  .icon-pop:hover { transform: scale(1.12) rotate(-4deg); }

  .link-underline { position: relative; }
  .link-underline::after {
    content: ""; position: absolute; left: 0; bottom: -3px; width: 0%; height: 2px;
    background: currentColor; transition: width 0.3s ease;
  }
  .link-underline:hover::after { width: 100%; }

  .card-hover { transition: transform 0.35s cubic-bezier(0.16,1,0.3,1), box-shadow 0.35s ease; }
  .card-hover:hover { transform: translateY(-6px); box-shadow: 0 20px 40px rgba(0,0,0,0.12); }

  @keyframes floatSlow { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
  @keyframes pulseDot { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.5; transform: scale(0.85); } }
  .pulse-dot { animation: pulseDot 1.8s ease-in-out infinite; display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--signal); margin-right: 8px; }

  /* ---- Scroll reveal ---- */
  .reveal {
    opacity: 0; transform: translateY(28px);
    transition: opacity 0.7s cubic-bezier(0.16,1,0.3,1), transform 0.7s cubic-bezier(0.16,1,0.3,1);
    will-change: opacity, transform;
  }
  .reveal.in { opacity: 1; transform: translateY(0); }

  /* ---- Hero ---- */
  #home { position: relative; width: 100%; overflow: hidden; background: var(--ink); }
  .hero-bg {
    position: absolute; inset: 0; opacity: 0.45;
    animation: fadeIn 1.4s ease-out both;
    transform: scale(1.15);
  }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  .hero-gradient {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(16,19,20,0.3) 0%, var(--ink) 95%);
  }
  .hero-inner { position: relative; padding: 80px 0 112px; }
  @media (min-width: 768px) { .hero-inner { padding: 112px 0 144px; } }
  .hero-eyebrow {
    display: flex; align-items: center;
    color: var(--signal); font-size: 13px; text-transform: uppercase; letter-spacing: 0.3em; font-weight: 700;
    margin-bottom: 24px;
    animation: fadeUp 0.7s cubic-bezier(0.16,1,0.3,1) both;
  }
  .hero-title {
    max-width: 900px; line-height: 0.92; color: var(--white);
    font-size: clamp(2.75rem, 8vw, 6.5rem);
    animation: fadeUp 0.9s cubic-bezier(0.16,1,0.3,1) both;
  }
  .hero-title span { color: var(--signal); }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(28px); } to { opacity: 1; transform: translateY(0); } }
  .hero-sub {
    max-width: 560px; margin-top: 24px; font-size: 16px; color: #c9cdcf;
    animation: fadeUp 0.9s cubic-bezier(0.16,1,0.3,1) 0.15s both;
  }
  @media (min-width: 768px) { .hero-sub { font-size: 18px; } }
  .hero-cta { margin-top: 40px; display: flex; flex-wrap: wrap; gap: 16px; animation: fadeUp 0.9s cubic-bezier(0.16,1,0.3,1) 0.3s both; }
  .btn-solid {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--signal); color: var(--white);
    padding: 16px 32px; font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
  }
  .btn-outline {
    display: inline-flex; align-items: center; gap: 8px;
    background: transparent; color: var(--white); border: 2px solid var(--white);
    padding: 16px 32px; font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
  }

  /* ---- Section headers ---- */
  .eyebrow { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.25em; color: var(--signal); margin-bottom: 12px; }
  .section-title { font-size: clamp(2rem, 5vw, 3rem); }

  /* ---- Gallery ---- */
  #gallery { background: var(--white); padding: 80px 0; }
  @media (min-width: 768px) { #gallery { padding: 112px 0; } }
  .gallery-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (min-width: 640px) { .gallery-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1024px) { .gallery-grid { grid-template-columns: repeat(4, 1fr); } }
  .gallery-item { aspect-ratio: 1 / 1; overflow: hidden; background: var(--fog); }
  .gallery-item img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s cubic-bezier(0.16,1,0.3,1); }
  .gallery-item:hover img { transform: scale(1.08); }

  /* ---- Packages ---- */
  #packages { background: var(--white); padding: 80px 0; }
  @media (min-width: 768px) { #packages { padding: 112px 0; } }
  .section-head {
    display: flex; flex-direction: column; gap: 16px; justify-content: space-between; margin-bottom: 48px;
  }
  @media (min-width: 768px) { .section-head { flex-direction: row; align-items: flex-end; } }
  .section-head p.note { max-width: 380px; font-size: 14px; color: var(--steel); }
  .section-head-right { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  @media (min-width: 768px) { .section-head-right { align-items: flex-end; } }

  .tracking-btn-pill {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--ink); color: var(--white);
    padding: 10px 18px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .grid-3 { display: grid; grid-template-columns: 1fr; gap: 24px; }
  @media (min-width: 640px) { .grid-3 { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .grid-3 { grid-template-columns: 1fr 1fr 1fr; } }
  .grid-4 { display: grid; grid-template-columns: 1fr; gap: 40px; }
  @media (min-width: 640px) { .grid-4 { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .grid-4 { grid-template-columns: repeat(4, 1fr); } }

  .package-card { background: var(--white); border: 1px solid var(--fog); overflow: hidden; }
  .package-img-wrap { position: relative; height: 240px; overflow: hidden; }
  .package-img-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s ease; }
  .package-card:hover .package-img-wrap img { transform: scale(1.1); }
  .package-tag {
    position: absolute; top: 16px; left: 16px;
    background: var(--ink); color: var(--white);
    padding: 4px 10px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
  }
  .package-body { padding: 24px; }
  .package-name { font-size: 22px; margin-bottom: 12px; }
  .package-desc { font-size: 14px; color: var(--steel); line-height: 1.6; margin-bottom: 20px; }
  .package-footer { display: flex; align-items: center; justify-content: flex-end; padding-top: 16px; border-top: 1px solid var(--fog); }
  .book-link { display: flex; align-items: center; gap: 4px; font-size: 14px; font-weight: 700; text-transform: uppercase; color: var(--signal); }

  /* ---- Why Travion ---- */


  /* ---- Reviews ---- */
  /* ---- Reviews ---- */
  #reviews { background: var(--ink); padding: 80px 0; }
  @media (min-width: 768px) { #reviews { padding: 112px 0; } }
  .reviews-empty { display: none; color: #8b9093; font-size: 14px; text-align: center; padding: 32px 0; }
  .review-card { position: relative; background: var(--white); padding: 28px; border: 1px solid rgba(255,255,255,0.08); }
  .review-delete {
    position: absolute; top: 14px; right: 14px;
    width: 26px; height: 26px; display: flex; align-items: center; justify-content: center;
    background: var(--fog); color: var(--steel);
    opacity: 0; transition: opacity 0.2s ease, background 0.2s ease, color 0.2s ease;
  }
  .review-card:hover .review-delete { opacity: 1; }
  .review-delete:hover { background: #fde2de; color: #c0392b; }
  .review-stars-display { display: flex; gap: 4px; margin-bottom: 16px; color: var(--signal); font-size: 16px; letter-spacing: 2px; }
  .review-quote { color: var(--ink); font-size: 15px; line-height: 1.6; margin-bottom: 20px; }
  .review-meta { border-top: 1px solid var(--fog); padding-top: 14px; display: flex; align-items: baseline; justify-content: space-between; }
  .review-name { color: var(--ink); font-size: 14px; font-weight: 700; }
  .review-date { color: var(--steel); font-size: 11px; }

  .write-review-panel { background: #17201d; padding: 36px; margin-top: 48px; border: 1px solid rgba(255,255,255,0.1); }
  .write-review-title { color: var(--white); font-size: 24px; margin-bottom: 8px; }
  .write-review-copy { color: #b7bbbd; font-size: 14px; margin-bottom: 24px; max-width: 480px; }
  .write-review-form { display: flex; flex-direction: column; gap: 16px; max-width: 480px; }
  .write-review-form input, .write-review-form textarea {
    width: 100%; padding: 14px 16px; font-size: 14px; font-family: inherit;
    background: var(--white); color: var(--ink); border: none; outline: none; resize: none;
  }
  .star-picker { display: flex; gap: 6px; }
  .star-btn {
    background: none; font-size: 30px; line-height: 1; color: #3d4745;
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .star-btn:hover { transform: scale(1.15); }
  .star-btn.filled { color: var(--signal); }
  .write-review-submit {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    background: var(--signal); color: var(--white);
    padding: 16px 24px; font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
    width: fit-content;
  }
  .review-success { display: none; align-items: center; gap: 12px; padding: 16px 0; }
  .review-success.show { display: flex; }
  .review-success p { color: var(--white); font-size: 14px; }

  #policy { background: var(--white); padding: 80px 0; }
  @media (min-width: 768px) { #policy { padding: 112px 0; } }
  .policy-list { max-width: 860px; }
  .policy-items { list-style: none; counter-reset: policy-counter; display: flex; flex-direction: column; gap: 0; }
  .policy-item {
    counter-increment: policy-counter;
    position: relative;
    padding: 20px 0 20px 52px;
    border-top: 1px solid var(--fog);
    font-size: 15px; line-height: 1.6; color: var(--ink);
  }
  .policy-items li:last-child { border-bottom: 1px solid var(--fog); }
  .policy-item::before {
    content: counter(policy-counter, decimal-leading-zero);
    position: absolute; left: 0; top: 20px;
    font-family: 'Archivo Black', sans-serif; font-size: 14px; color: var(--signal);
  }

  /* ---- Contact ---- */
  #contact { background: var(--white); padding: 80px 0; }
  @media (min-width: 768px) { #contact { padding: 112px 0; } }
  .contact-grid { display: grid; grid-template-columns: 1fr; gap: 56px; }
  @media (min-width: 1024px) { .contact-grid { grid-template-columns: 1fr 1fr; } }
  .contact-title { font-size: clamp(2rem, 5vw, 3rem); margin-bottom: 32px; }
  .contact-links { display: flex; flex-direction: column; gap: 20px; }
  .contact-link { display: flex; align-items: center; gap: 16px; font: inherit; padding: 0; border: none; cursor: pointer; color: inherit; }
  .contact-icon { width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: var(--ink); }
  .contact-icon.whatsapp { background: var(--whatsapp); }
  .contact-icon.location { background: var(--signal); }
  .contact-label { font-size: 12px; text-transform: uppercase; letter-spacing: 0.15em; color: var(--steel); }
  .contact-value { font-size: 16px; font-weight: 600; transition: opacity 0.2s ease; }
  .contact-link:hover .contact-value { opacity: 0.7; }
  .promise-box { margin-top: 40px; padding: 24px; background: var(--fog); }
  .location-map-wrap { display: none; margin-top: 24px; }
  .location-map-wrap.show { display: block; animation: fadeUp 0.5s cubic-bezier(0.16,1,0.3,1) both; }
  .tracking-panel-status { padding: 16px; background: var(--fog); color: var(--steel); font-size: 14px; margin-bottom: 12px; }
  .tracking-coords { padding: 16px; background: var(--fog); font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 600; color: var(--ink); display: none; }
  .tracking-options { display: none; flex-wrap: wrap; gap: 10px; margin-top: 14px; }
  .tracking-opt {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--ink); color: var(--white); border: none; cursor: pointer; font: inherit;
    padding: 10px 16px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
    transition: opacity 0.2s ease;
  }
  .tracking-opt:hover { opacity: 0.8; }
  .promise-head { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
  .promise-head span { font-size: 14px; font-weight: 700; text-transform: uppercase; }
  .promise-body { font-size: 14px; color: var(--steel); }

  .feedback-panel { background: var(--ink); padding: 32px; }
  .feedback-title { color: var(--white); font-size: 24px; margin-bottom: 8px; }
  .feedback-copy { color: #b7bbbd; font-size: 14px; margin-bottom: 24px; }
  .feedback-form { display: flex; flex-direction: column; gap: 16px; }
  .feedback-form input, .feedback-form textarea {
    width: 100%; padding: 14px 16px; font-size: 14px; font-family: inherit;
    background: var(--white); color: var(--ink); border: none; outline: none; resize: none;
  }
  .feedback-submit {
    width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px;
    background: var(--signal); color: var(--white);
    padding: 16px 24px; font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
  }
  .feedback-note { font-size: 12px; color: #8b9093; text-align: center; }
  .feedback-success { display: none; align-items: center; gap: 12px; padding: 24px 0; }
  .feedback-success.show { display: flex; }
  .feedback-success p { color: var(--white); font-size: 14px; }

  /* ---- Footer ---- */
  footer { background: var(--ink); border-top: 1px solid rgba(255,255,255,0.1); padding: 40px 0; }
  .footer-inner { display: flex; flex-direction: column; align-items: center; justify-content: space-between; gap: 16px; text-align: center; }
  @media (min-width: 768px) { .footer-inner { flex-direction: row; text-align: left; } }
  .footer-logo-img { height: 40px; width: auto; }
  .footer-note { font-size: 12px; color: #8b9093; text-align: center; }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .reveal, .hero-title, .hero-eyebrow, .hero-sub, .hero-cta, .hero-bg,
    .card-hover, .btn-anim, .icon-pop, .nav-logo-img, .pulse-dot, .loader-logo-img, .loader-bar {
      animation: none !important; transition: none !important; opacity: 1 !important; transform: none !important; width: 100% !important;
    }
  }
</style>
</head>
