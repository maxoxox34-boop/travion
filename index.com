        <div class="feedback-success" id="feedback-success">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0b5fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <p>Your email app should be open — just hit send to reach expedition1.618@gmail.com.</p>
        </div>

        <form class="feedback-form" id="feedback-form">
          <input type="text" id="fb-name" placeholder="Your name" required />
          <textarea id="fb-message" rows="5" placeholder="Your feedback or question" required></textarea>
          <button type="submit" class="feedback-submit btn-anim">
            Send Feedback
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
          </button>
